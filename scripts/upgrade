#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================

#ynh_app_setting_set_default --key=mail_user‎ --value=noreply

if [[ "${mail_user:-}" != "noreply" && "${mail_user:-}" != "contact" ]]; then
    mail_user="noreply"
    ynh_app_setting_set --key=mail_user --value="noreply" 
fi

ynh_app_setting_set_default --key=altcha --value="off"
ynh_app_setting_set_default --key=altcha_hmackey --value=""
ynh_app_setting_set_default --key=recaptcha --value="off"
ynh_app_setting_set_default --key=recaptcha_public --value=""
ynh_app_setting_set_default --key=recaptcha_private --value=""

salt=$(ynh_app_setting_get --app=$app --key=salt)
api_key_secret=$(ynh_app_setting_get --app=$app --key=api_key_secret)
app_key=$(ynh_app_setting_get --app=$app --key=app_key)
language=$(ynh_app_setting_get --app=$app --key=language)
timezone=$(ynh_app_setting_get --app=$app --key=timezone)

#=================================================
# Check installed plugins and compare them to the core list
#=================================================
ynh_script_progression "Checking plugins folder for non core plugins..."

core_plugins="
plugins/blocks/browse
plugins/blocks/developedBy
plugins/blocks/information
plugins/blocks/languageToggle
plugins/blocks/makeSubmission
plugins/blocks/subscription
plugins/gateways
plugins/generic/announcementFeed
plugins/generic/citationStyleLanguage
plugins/generic/credit
plugins/generic/crossref
plugins/generic/customBlockManager
plugins/generic/datacite
plugins/generic/driver
plugins/generic/dublinCoreMeta
plugins/generic/googleAnalytics
plugins/generic/googleScholar
plugins/generic/htmlArticleGalley
plugins/generic/jatsTemplate
plugins/generic/lensGalley
plugins/generic/pdfJsViewer
plugins/generic/recommendByAuthor
plugins/generic/recommendBySimilarity
plugins/generic/staticPages
plugins/generic/tinymce
plugins/generic/usageEvent
plugins/generic/webFeed
plugins/importexport/doaj
plugins/importexport/native
plugins/importexport/pubmed
plugins/importexport/users
plugins/metadata/dc11
plugins/oaiMetadataFormats/dc
plugins/oaiMetadataFormats/marc
plugins/oaiMetadataFormats/marcxml
plugins/oaiMetadataFormats/oaiJats
plugins/oaiMetadataFormats/rfc1807
plugins/paymethod/manual
plugins/paymethod/paypal
plugins/pubIds/urn
plugins/reports/articles
plugins/reports/counter
plugins/reports/reviewReport
plugins/reports/subscriptions
plugins/themes/default
"
extra_plugins=""

pushd "$install_dir"

for plugin_path in plugins/*/*; do
    if [ -d "$plugin_path" ]; then
        if [[ "$core_plugins" != *"$plugin_path"* ]]; then
            extra_plugins="$extra_plugins $plugin_path"
 
            echo "Keeping custom plugin: $plugin_path"
        fi
    fi
done

popd

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="config.inc.php public $extra_plugins"

ynh_config_add --template="config.inc.php" --destination="$install_dir/config.inc.php"

ynh_replace --match="installed = Off" --replace="installed = On" --file="$install_dir/config.inc.php"

ynh_store_file_checksum "$install_dir/config.inc.php"

chown -R "$app:www-data" "$install_dir"

pushd $install_dir
  php$php_version tools/upgrade.php check
  php$php_version -d memory_limit=2048M tools/upgrade.php upgrade
  ynh_composer_exec require altcha-org/altcha
popd

chown -R "$app:www-data" "$install_dir"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

ynh_config_add --template=".cron" --destination="/etc/cron.d/$app"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
